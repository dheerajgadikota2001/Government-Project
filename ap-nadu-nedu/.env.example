# Copy to .env to override defaults.
# Base URL of the backend API (no trailing slash).
# Local dev default matches: uvicorn app.main:app --reload --port 8001
VITE_API_URL=http://127.0.0.1:8001/api/v1

# Google Analytics 4 measurement ID (optional).
# Deliberately NOT set here or in .env: with it unset the analytics layer is
# fully inert -- no script is loaded and no request is made -- so local
# development never appears in the reports. The real value lives in the
# committed .env.production and therefore applies only to `npm run build`.
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
