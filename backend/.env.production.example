# ============================================================
# Production environment — Cloud Run (asia-south1 / Mumbai)
#
# NOTHING SECRET LIVES IN THIS FILE. It documents which variables the
# service needs. The real values go into Secret Manager (step 06 of
# docs/GCP-SETUP.html) and are injected with --set-secrets / --set-env-vars.
# ============================================================

APP_ENV=production
DEBUG=false

# --- From Secret Manager (--set-secrets) ---
# DATABASE_URL   postgresql+asyncpg://apnn:<password>@/applatform?host=/cloudsql/<project>:asia-south1:apnn-db
# SECRET_KEY     long random string; also salts the IP hashes on the community board
# ADMIN_KEY      your moderation key — sent as the X-Admin-Key header

# --- Plain env vars (--set-env-vars) ---
# The browser never needs CORS while the site is served through the Firebase
# /api rewrite (same origin). This list matters only if the API is called
# directly — keep your real origins here, never "*".
ALLOWED_ORIGINS=https://ap-nadu-nedu.web.app,https://ap-nadu-nedu.firebaseapp.com

# Cloud Run gives 1 vCPU on the small tier and handles concurrency itself.
WEB_CONCURRENCY=1

# Redis is OPTIONAL. Leave it unset in production: the cache layer detects an
# unreachable Redis, marks it down and serves straight from Postgres. Add a
# Memorystore URL later only if response times call for it.
# REDIS_URL=

# Elasticsearch is likewise optional; search falls back to Postgres queries.
# ELASTICSEARCH_URL=
