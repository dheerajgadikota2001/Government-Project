# ============================================================
# AP Politics Platform — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to git
# ============================================================

# App
APP_ENV=development          # development | staging | production
APP_NAME="AP Politics Platform"
APP_VERSION=1.0.0
DEBUG=true
SECRET_KEY=your-super-secret-key-change-this-in-production

# Database (PostgreSQL)
# Local dev: postgresql+asyncpg://postgres:password@localhost:5432/applatform
# Supabase: get from Supabase dashboard > Settings > Database
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/applatform
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis
# Local dev: redis://localhost:6379/0
# Upstash: get from Upstash dashboard
REDIS_URL=redis://localhost:6379/0

# Google Cloud (Translation, STT, TTS, Storage)
# Create a service account in GCP > IAM & Admin > Service Accounts
# Download JSON key and put the path here
GOOGLE_APPLICATION_CREDENTIALS=/path/to/gcp-service-account.json
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GCS_BUCKET_NAME=ap-platform-documents   # Google Cloud Storage bucket for PDFs

# Anthropic (Claude API for news summarization)
# Get from https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Firebase (Push Notifications)
# Download serviceAccount.json from Firebase Console > Project Settings > Service Accounts
FIREBASE_CREDENTIALS_PATH=/path/to/firebase-service-account.json

# Elasticsearch
# Local dev: http://localhost:9200
# Elastic Cloud: get from Elastic Cloud console
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX_PREFIX=applatform

# Celery (uses Redis as broker)
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Rate Limiting
RATE_LIMIT_PER_MINUTE=100

# Scraper Settings
SCRAPER_USER_AGENT="APNaduNedu-Bot/1.0 (Public data mirror; independent citizen project; not affiliated with AP Govt; contact: corrections@apnadunedu.in)"
SCRAPER_REQUEST_DELAY=2   # seconds between requests (be polite to government servers)
SCRAPER_TIMEOUT=30

# CORS (add your frontend domains)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:5175,http://127.0.0.1:5175,http://localhost:4173,http://127.0.0.1:4173

# Voice Assistant
VOICE_ASSISTANT_NAME=Mitra
