# Copy to deploy/.env.prod on the server and fill in. Never commit .env.prod.

# ---- domain / TLS ----
API_HOST=api.apnadunedu.in
ACME_EMAIL=you@example.com

# ---- database (docker-internal; pick a long random password) ----
POSTGRES_USER=apnn
POSTGRES_PASSWORD=CHANGE_ME_long_random
POSTGRES_DB=applatform

# ---- app ----
APP_ENV=production
DEBUG=false
SECRET_KEY=CHANGE_ME_64_random_chars
ADMIN_KEY=CHANGE_ME_rotate_the_one_pasted_in_chat
ANTHROPIC_API_KEY=            # only if the Mitra voice assistant is enabled in prod
ALLOWED_ORIGINS=https://apnadunedu.in,https://www.apnadunedu.in,https://apnadunedu.pages.dev
RATE_LIMIT_PER_MINUTE=100

# ---- MoSPI monthly edition the daily job ingests (see app/scrapers/mospi_projects.py) ----
MOSPI_FLASH_URL=https://mospi.gov.in/uploads/publications_reports/publications_reports1782388627305_2544b8eb-3ea2-40eb-ab6e-b150c40c4a9e_FlashReport_May_2026.pdf
MOSPI_FLASH_LABEL=MoSPI flash report, May 2026
MOSPI_FLASH_AS_OF=2026-05-31
MOSPI_FLASH_PDF=/app/fetched/FlashReport_May_2026.pdf

# ---- off-site backups → Cloudflare R2 (optional but recommended; free 10 GB) ----
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=apnn-backups
